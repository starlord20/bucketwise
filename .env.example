# Copy to .env.local and fill in. Never commit .env.local (see .gitignore).
# Get values from https://dev.meta.ai — Meta Muse API is the ONLY backend used.

# $150 credits key (required for live Wonder/Spark/SAM/Image; app falls back to mock without it)
META_API_KEY=
# Base URL from dev.meta.ai (required with key)
META_API_BASE=
# Model overrides (defaults already verified live; change only if the portal lists new IDs)
# META_WONDER_MODEL=muse-wonder-1.0
# META_SPARK_MODEL=muse-spark-1.3
# META_SAM_MODEL=sam-3.1
# META_IMAGE_MODEL=muse-image-1.0

# Optional: Gmail + Drive import (Google Cloud Console → OAuth 2.0 client)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Optional: daily digest email
# RESEND_API_KEY=
